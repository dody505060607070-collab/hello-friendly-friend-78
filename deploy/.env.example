# ===== مثراء — متغيرات الخادم (Hostinger VPS) =====
# انسخ هذا الملف إلى deploy/.env واملأ القيم. لا ترفعه إلى Git.

# ---- 1) قاعدة البيانات المحلية (Docker) ----
POSTGRES_PASSWORD=            # كلمة مرور قوية (تولّدها scripts/00-generate-keys.sh)
JWT_SECRET=                   # 40 حرفًا على الأقل
ANON_KEY=                     # يُولَّد من JWT_SECRET
SERVICE_ROLE_KEY=             # يُولَّد من JWT_SECRET
REALTIME_ENC_KEY=             # 16 بايت
REALTIME_SECRET_KEY_BASE=     # 64 حرفًا

PUBLIC_BASE_URL=https://your-domain.sa

# ---- 2) ما يقرأه التطبيق نفسه ----
SUPABASE_URL=https://your-domain.sa/api-gw
SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
VITE_SUPABASE_URL=https://your-domain.sa/api-gw
VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}

# ---- 3) الذكاء الاصطناعي (Google أولًا ثم Groq) ----
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GROQ_API_KEY=
# LOVABLE_API_KEY: لا تضعه — النظام يتخطاه تلقائيًا

# ---- 4) التخزين على قرص الـVPS (50–70 جيجا أو أكثر) ----
STORAGE_DRIVER=local
VITE_STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/www/mithraa/storage
STORAGE_MAX_UPLOAD_MB=200

# ---- 5) واتساب Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+9665XXXXXXXX

# ---- 6) تسجيل الدخول بجوجل (اختياري) ----
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 7) البريد (اختياري، لاستعادة كلمة المرور) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.sa

# ---- 8) مصدر النقل (يُستخدم مرة واحدة أثناء الترحيل فقط) ----
SOURCE_DB_URL=                # رابط قاعدة البيانات الحالية
SOURCE_SUPABASE_URL=
SOURCE_SERVICE_ROLE_KEY=
